# Glass stack environment configuration
#
# Copy this file to .env and edit with your values.
# DO NOT commit .env to version control.

# Required: HTTP Basic auth for /pair and /qr endpoints
# Use strong, randomly generated credentials
GLASS_PAIR_USERNAME=admin
GLASS_PAIR_PASSWORD=change-me-to-a-strong-random-password

# Public ntfy URL that the phone will use for signaling
# This is the URL exposed through your reverse proxy
# If you use path prefix (e.g., /ntfy), the reverse proxy must strip it
PUBLIC_NTFY_URL=https://glass.example.com/ntfy

# STUN server for WebRTC NAT traversal
# Google's public STUN server works for most cases
GLASS_STUN_SERVER=stun:stun.l.google.com:19302

# Invite TTL in seconds (how long before QR expires)
GLASS_INVITE_TTL=300

# Local port for glass-peer HTTP server
GLASS_PEER_PORT=8080
