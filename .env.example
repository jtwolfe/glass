# Glass stack environment configuration
#
# Copy this file to .env and edit with your values.
# DO NOT commit .env to version control.

# Required: HTTP Basic auth for localhost /pair and /qr
# Use strong, randomly generated credentials
GLASS_PAIR_USERNAME=admin
GLASS_PAIR_PASSWORD=changeme

# Invite TTL in seconds (how long before QR expires)
GLASS_INVITE_TTL=300

# Optional QR wss hint (operator hostname). Leave unset if the phone sets Settings.
# GLASS_PUBLIC_WSS_URL=wss://chat.example.com/session
