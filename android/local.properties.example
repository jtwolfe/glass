# Glass inbox configuration
# Copy this file to local.properties and fill in the values.
# Do NOT commit local.properties to git.
#
# Get these values from your inbox administrator.
# The inbox URL should be a public HTTPS endpoint (never localhost).
# The token is the GLASS_PHONE_TOKEN issued for your device.

glass.inbox.url=
glass.inbox.token=

# Android SDK location (auto-generated by Android Studio)
# sdk.dir=/path/to/Android/Sdk
